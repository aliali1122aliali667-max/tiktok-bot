# Telegram bot token (from @BotFather)
BOT_TOKEN=your-telegram-bot-token

# AI provider (OpenAI-compatible endpoint). Works with Google Gemini's OpenAI API.
USER_LLM_API_KEY=your-api-key-here
USER_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
USER_LLM_MODEL=gemini-2.0-flash
USER_LLM_VISION_MODEL=gemini-2.0-flash
USER_LLM_IMAGE_MODEL=gemini-2.5-flash-image
USER_LLM_SYSTEM_PROMPT=أنت مساعد ذكي في بوت تيليجرام. جاوب بنفس لغة المستخدم، وخلّي الردود واضحة ومختصرة.
USER_LLM_MAX_HISTORY=12
USER_LLM_MAX_TOKENS=1024

# TikTok download settings
MAX_VIDEO_SIZE_MB=49
DOWNLOAD_TIMEOUT_MS=120000
TEMP_DIR=tmp
YTDLP_BINARY=yt-dlp

# Image processing settings
IMAGE_MAX_SIZE_MB=20
IMAGE_TEMP_DIR=tmp

# Health check server
PORT=3000

# Temporary email settings
DAILY_EMAIL_LIMIT=10
EMAIL_PROVIDER_PRIMARY=mailtm
EMAIL_PROVIDER_FALLBACK=1secmail

# Virtual phone number settings (SMS)
SMS_PROVIDER_PRIMARY=sms-receive
SMS_PROVIDER_FALLBACK1=receive-smss
SMS_PROVIDER_FALLBACK2=quackr
QUACKR_API_KEY=
DAILY_SMS_LIMIT=5
